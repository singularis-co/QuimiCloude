exports[`paridad del acondicionador — el detalle > R8 R11 R24 — en acondicionamiento por otra persona, con equipo, sin receta ni reparto 1`] = `
"
div role=generic
  div role=generic data-testid="conditioning-order-screen" class="flex flex-col gap-4 md:p-6 min-h-dvh p-4"
    h1 role=heading name="2026-0000041" data-testid="conditioning-order-number" class="font-semibold text-2xl"
      "2026-0000041"
    p role=paragraph data-testid="conditioning-order-recipe" class="text-base text-muted-foreground"
      "Esta receta está dada de baja."
    p role=paragraph data-testid="conditioning-order-quantity" class="font-medium text-base"
      "Cantidad:"
      "20.5"
    section role=region name="Reparto" aria-labelledby="conditioning-order-distribution-heading" data-testid="conditioning-order-distribution" class="flex flex-col gap-2"
      h2 role=heading name="Reparto" class="font-medium text-base"
        "Reparto"
      p role=paragraph class="text-base"
        span role=generic data-testid="order-distribution-full"
          "Sin presentación"
    p role=paragraph data-testid="conditioning-order-status" class="font-medium text-base"
      "En acondicionamiento"
    p role=paragraph data-testid="conditioning-order-conditioner" class="text-base text-muted-foreground"
      "Lo acondiciona Berta Ruiz."
    section role=region name="Equipo" aria-labelledby="conditioning-team-heading" data-testid="conditioning-team-list" class="flex flex-col gap-2"
      h2 role=heading name="Equipo" class="font-medium text-base"
        "Equipo"
      ul role=list class="flex flex-col gap-3"
        li role=listitem data-testid="conditioning-team-list-group" class="flex flex-col gap-1"
          span role=generic data-testid="conditioning-team-list-group-name" class="font-medium text-sm"
            "Personas sueltas"
          ul role=list class="flex flex-col gap-1"
            li role=listitem data-testid="conditioning-team-list-member" class="text-base"
              "Diego Pérez"
            li role=listitem data-testid="conditioning-team-list-member" class="text-base"
              "Gema Ortiz"
        li role=listitem data-testid="conditioning-team-list-group" class="flex flex-col gap-1"
          span role=generic data-testid="conditioning-team-list-group-name" class="font-medium text-sm"
            "Turno de mañana"
          ul role=list class="flex flex-col gap-1"
            li role=listitem data-testid="conditioning-team-list-member" class="text-base"
              "Carla Gómez"
            li role=listitem data-testid="conditioning-team-list-member" class="text-base"
              "Fabio Núñez"
        li role=listitem data-testid="conditioning-team-list-group" class="flex flex-col gap-1"
          span role=generic data-testid="conditioning-team-list-group-name" class="font-medium text-sm"
            "Turno de tarde"
          ul role=list class="flex flex-col gap-1"
            li role=listitem data-testid="conditioning-team-list-member" class="text-base"
              "Elena Soto"
    a role=link name="Volver a «Por acondicionar»" data-testid="conditioning-order-back-link" href="/asignacion?vista=por_acondicionar" class="font-medium inline-flex items-center min-h-11 min-w-11 text-base underline w-fit"
      "Volver a «Por acondicionar»"
"
`;

