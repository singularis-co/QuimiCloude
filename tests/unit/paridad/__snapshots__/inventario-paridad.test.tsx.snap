                svg aria-hidden="true" height="24" width="24" class="lucide lucide-chevron-down pointer-events-none size-4 text-muted-foreground"
              input role=textbox aria-hidden="true" style="clip-path: inset(50%); overflow: hidden; white-space: nowrap; border: 0px; padding: 0px; width: 1px; height: 1px; margin: -1px; position: fixed; top: 0px; left: 0px;"
"
`;

